# Copy this file to .env for local development. All values are read from environment variables.
PORT=5000

# MongoDB connection (the connection string is built from these values)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=fittrack
# Leave empty to connect without authentication. When set, authSource=admin is used.
MONGO_USER=
MONGO_PASSWORD=

# Secret used to sign JWT tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Allowed origin(s) for CORS, comma separated. Leave empty to disable cross-origin requests.
CORS_ORIGIN=http://localhost:5173

# Optional: path to an alternative seed file for exercises
# SEED_FILE=./data/seed-exercises.json
